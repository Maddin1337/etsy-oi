{
  "name": "@etsy-oi/pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@etsy-oi/db": "workspace:*",
    "@etsy-oi/extractors": "workspace:*",
    "@etsy-oi/scoring": "workspace:*",
    "@etsy-oi/shared-types": "workspace:*",
    "@etsy-oi/validators": "workspace:*",
    "@playwright/test": "^1.52.0",
    "pg": "^8.15.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/pg": "^8.11.14",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
